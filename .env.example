# 环境变量模板
# 复制为 .env 并填写

# OpenRouter API Key（你的 $5 余额在这里用）
OPENROUTER_API_KEY=sk-or-v1-...

# Pinterest API（可选，免费注册 https://developers.pinterest.com/apps/）
PINTEREST_TOKEN=

# X/Twitter API（推荐 GetXAPI，$0.001/次，送 $0.1）
# 注册 https://www.getxapi.com/signup → 拿 API Key
X_API_KEY=

# X API v2 Bearer Token（备选，免费版不支持搜索）
X_BEARER_TOKEN=
